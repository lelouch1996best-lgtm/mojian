{
  "name": "ai-script-tool",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "predev": "rm -rf .next",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "prebuild": "rm -rf .next",
    "start": "next start",
    "electron:dev": "concurrently -k \"next dev\" \"wait-on tcp:3000 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "electron:build:next": "cross-env NEXT_PUBLIC_STORAGE_TOKEN=mojian-electron-local-token next build",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:build": "npm run electron:rebuild && npm run electron:build:next && npm run electron:compile && electron-builder && npm rebuild better-sqlite3",
    "gen:keypair": "tsx tools/gen-keypair.ts",
    "gen:license": "tsx tools/gen-license.ts",
    "license:tool": "tsx tools/license-tool.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "cos-nodejs-sdk-v5": "^2.16.0-beta.9",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.16",
    "tailwindcss": "3.4.6",
    "tsx": "^4.16.0",
    "typescript": "5.5.3",
    "wait-on": "^7.2.0"
  }
}
